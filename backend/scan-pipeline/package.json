    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "multer": "^2.2.0",
    "openai": "^7.4.0",
    "paddleocr": "^1.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
