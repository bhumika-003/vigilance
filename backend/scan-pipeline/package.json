  "private": true,
 "scripts": {
  "dev": "tsx watch src/server.ts",
  "start": "tsx src/server.ts",
  "build": "tsc && mkdir -p dist/src/ocr && cp src/ocr/paddle_ocr.py dist/src/ocr/paddle_ocr.py",
  "typecheck": "tsc --noEmit",
  "test": "tsx --test test/**/*.test.ts"
},
  "dependencies": {
    "@google-cloud/vision": "^6.0.0",
    "@google/genai": "^2.17.0",
